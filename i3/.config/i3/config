# Profiles (prime.conf, rice.conf) live in ~/.config/i3; `i3-profile <name>` points
# active.conf at one and reloads. Absolute path: i3 resolves this file through its
# symlink into the dotfiles repo, so a relative include would look in the wrong dir.
include ~/.config/i3/active.conf

# Escape hatch that works even if the include above fails and no profile loads.
bindsym Mod4+Mod1+Escape exit
